{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VideoNote (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build VideoNote",
      "program": "${workspaceFolder}/VideoNote.Server/bin/Debug/net10.0/VideoNote.Server.dll",
      "cwd": "${workspaceFolder}/VideoNote.Server",
      "launchSettingsFilePath": "${workspaceFolder}/VideoNote.Server/Properties/launchSettings.json",
      "launchSettingsProfile": "http",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
