@page "/Error"
@using System.Diagnostics

<PageTitle>错误 · VideoNote</PageTitle>

<div class="panel" style="max-width:640px;margin:3rem auto;text-align:center;">
    <div class="empty-ico" style="color:var(--red);background:var(--red-dim);border-color:rgba(226,96,79,0.35);">
        <svg class="ico-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    </div>
    <h1 style="font-size:1.4rem;margin-bottom:0.6rem;">处理请求时发生错误</h1>
    <p class="dim">请返回重试；若持续出现，请检查服务端日志。</p>
    @if (ShowRequestId)
    {
        <p class="tc" style="margin-top:0.8rem;">Request ID: @RequestId</p>
    }
    <h3 style="margin:1.4rem 0 0.5rem;">开发模式</h3>
    <p class="muted small" style="text-align:left;">切换到 <strong>Development</strong> 环境可显示更详细的异常信息。开发环境不应部署到生产，可能向最终用户泄露敏感信息。本地调试请设置环境变量 <code>ASPNETCORE_ENVIRONMENT=Development</code> 并重启应用。</p>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
