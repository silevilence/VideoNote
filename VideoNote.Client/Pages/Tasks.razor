@page "/tasks"
@inherits OperationPage
@inject ApiClient Api
@inject IJSRuntime JS
@using VideoNote.Shared.Contracts
@using VideoNote.Shared.Domain
@using VideoNote.Client.Components
@using VideoNote.Client.Services

<PageTitle>任务列表 · VideoNote</PageTitle>
<AnalysisWatch Refresh="() => Refresh(Load)" />

<div class="page-head">
    <div class="titles">
        <span class="eyebrow">SCREENING LOG</span>
        <h1>任务列表</h1>
        <p class="page-sub">所有已创建的解读任务。状态与进度实时更新，点击文件名查看详情。</p>
    </div>
    <div class="head-actions">
        <button type="button" class="btn btn-ghost" disabled="@Busy" @onclick="() => Run(Load)">
            <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            刷新
        </button>
        <NavLink class="btn btn-primary" href="tasks/new">
            <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            新建任务
        </NavLink>
    </div>
</div>

<ErrorAlert Message="@Error" />
<ErrorAlert Message="@RefreshError" />
<NoticeAlert Message="@Notice" />

<div class="filter-bar" role="group" aria-label="按状态筛选">
    @foreach (var (key, name, match) in Filters)
    {
        <button type="button" class="filter-chip @(_filter == key ? "is-active" : "")" disabled="@Busy" @onclick="() => SetFilter(key)">
            @name<span class="n">@_tasks.Count(match)</span>
        </button>
    }
</div>

@if (Busy && _tasks.Count == 0)
{
    <LoadingCards Count="3" />
}
else if (!visibleTasks.Any())
{
    <div class="empty">
        <div class="empty-ico">
            <svg class="ico-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 9l5 3-5 3z"/></svg>
        </div>
        <div class="empty-title">暂无任务。</div>
        <p class="empty-desc">上传一段视频创建第一个解读任务，或切换上方筛选条件。</p>
        <NavLink class="btn btn-primary" href="tasks/new">新建任务</NavLink>
    </div>
}
else
{
    <div class="card-list">
        @foreach (var task in visibleTasks)
        {
            <div class="item" @key="task.Id">
                <span class="@Ui.StatusClass(task.Status)"><span class="dot"></span>@Ui.StatusName(task.Status)</span>
                <div class="item-main">
                    <NavLink class="item-title" href="@($"tasks/{task.Id}")">@task.OriginalFileName</NavLink>
                    <div class="item-meta">
                        <span class="@Ui.ModeClass(task.Mode)">@Ui.ModeName(task.Mode)</span>
                        @if (!string.IsNullOrEmpty(task.StageDescription))
                        {
                            <span class="desc">@task.StageDescription · @task.ProgressPercent%</span>
                        }
                    </div>
                </div>
                <span class="tc nowrap">@Ui.Time(task.CreatedAtUtc)</span>
                <div class="item-actions">
                    <button type="button" class="icon-btn danger" title="删除任务及物料" aria-label="删除任务及物料"
                            disabled="@Busy" @onclick="() => Delete(task)">
                        <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6M14 11v6"/></svg>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<TaskDto> _tasks = [];
    private string _filter = "all";

    private (string Key, string Name, Func<TaskDto, bool> Match)[] Filters =>
    [
        ("all", "全部", _ => true),
        ("running", "进行中", t => Ui.IsActive(t.Status)),
        ("completed", "已完成", t => t.Status == AnalysisTaskStatus.Completed),
        ("failed", "失败", t => t.Status == AnalysisTaskStatus.Failed),
        ("canceled", "已取消", t => t.Status == AnalysisTaskStatus.Canceled)
    ];

    private IEnumerable<TaskDto> visibleTasks => _tasks.Where(Filters.First(f => f.Key == _filter).Match);

    protected override Task OnInitializedAsync() => Refresh(Load);

    private void SetFilter(string key)
    {
        _filter = key;
        Notice = null;
    }

    private async Task Load() => _tasks = await Api.Get<List<TaskDto>>("api/tasks");

    private Task Delete(TaskDto task) => Run(async () =>
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"删除「{task.OriginalFileName}」及视频、帧、音频、字幕和对话记录？")) return;
        await Api.Delete($"api/tasks/{task.Id}");
        Notice = $"已删除任务「{task.OriginalFileName}」。";
        await Load();
    });

}
