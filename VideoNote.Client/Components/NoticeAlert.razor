@if (Message is not null)
{
    <div class="alert alert-success" role="status">
        <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        @Message
    </div>
}

@code {
    /// <summary>操作结果提示；为 null 时不渲染。</summary>
    [Parameter] public string? Message { get; set; }
}
