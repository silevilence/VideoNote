@using VideoNote.Shared.Contracts
@using VideoNote.Client.Components

<EditForm Model="Value" OnValidSubmit="Save" FormName="model">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <fieldset disabled="@Busy" style="border:none;padding:0;margin:0;">
        <div class="grid cols-2">
            <div class="field">
                <label for="model-name">Model ID</label>
                <InputText id="model-name" class="form-control" @bind-Value="Value.ModelId" placeholder="例如 deepseek-v4-flash-vision-exp" />
            </div>
            <div class="field">
                <label for="model-context">上下文窗口（token）</label>
                <InputNumber id="model-context" class="form-control" @bind-Value="Value.ContextWindow" />
            </div>
        </div>
        <div class="field">
            <span class="field-label">模型能力（可任意组合，用于按模式过滤候选）</span>
            <div class="grid cols-3">
                <label class="check"><InputCheckbox class="check-input" @bind-Value="Value.SupportsReasoning" /> 思考</label>
                <label class="check"><InputCheckbox class="check-input" @bind-Value="Value.SupportsToolCalling" /> 工具调用</label>
                <label class="check"><InputCheckbox class="check-input" @bind-Value="Value.SupportsStreaming" /> 流式</label>
                <label class="check"><InputCheckbox class="check-input" @bind-Value="Value.SupportsImage" /> 图片</label>
                <label class="check"><InputCheckbox class="check-input" @bind-Value="Value.SupportsAudio" /> 音频</label>
                <label class="check"><InputCheckbox class="check-input" @bind-Value="Value.SupportsVideo" /> 视频</label>
            </div>
        </div>
        <div class="head-actions">
            <button class="btn btn-primary" type="submit">保存模型</button>
            <button class="btn btn-ghost" type="button" @onclick="Cancel">取消</button>
        </div>
    </fieldset>
</EditForm>
@code {
    [Parameter, EditorRequired] public ModelInput Value { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
}
