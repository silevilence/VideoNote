@implements IDisposable
@inherits OperationPage
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@using VideoNote.Shared.Contracts
@using VideoNote.Shared.Domain
@using VideoNote.Client.Components
@using VideoNote.Client.Services

<PageTitle>任务详情 · VideoNote</PageTitle>
<AnalysisWatch TaskId="Id" Refresh="() => Refresh(RefreshTask)" TextReceived="ReceiveText" />

@if (Busy && _task is null)
{
    <p class="loading-line"><span class="spinner"></span>正在加载任务…</p>
}
else if (_task is null && (Error ?? RefreshError) is not null)
{
    <ErrorAlert Message="@Error" />
    <ErrorAlert Message="@RefreshError" />
    <ErrorAlert Message="@_metadataError" />
    <p class="loading-line">
        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => Refresh(RefreshTask)">重试加载</button>
        <NavLink class="btn btn-ghost btn-sm" href="tasks">返回任务列表</NavLink>
    </p>
}
else if (_task is null)
{
    <div class="empty">
        <div class="empty-ico">
            <svg class="ico-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <div class="empty-title">找不到这个任务</div>
        <p class="empty-desc">任务可能已被删除。</p>
        <NavLink class="btn btn-ghost" href="tasks">返回任务列表</NavLink>
    </div>
}
else
{
    <div class="page-head">
        <div class="titles">
            <span class="eyebrow">TASK DETAIL</span>
            <h1 style="word-break:break-all;">@_task.OriginalFileName</h1>
            <p class="page-sub">
                <span class="@Ui.StatusClass(_task.Status)"><span class="dot"></span>@Ui.StatusName(_task.Status)</span>
                <span class="@Ui.ModeClass(_task.Mode)" style="margin-left:0.4rem;">@Ui.ModeName(_task.Mode)</span>
            </p>
        </div>
        <div class="head-actions">
            @if (Ui.IsActive(_task.Status))
            {
                <button class="btn btn-danger" disabled="@Busy" @onclick="Cancel">取消分析</button>
            }
            <NavLink class="btn btn-ghost" href="tasks">
                <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                返回列表
            </NavLink>
            <button type="button" class="btn btn-danger" disabled="@Busy" @onclick="Delete">
                <svg class="ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                删除任务
            </button>
        </div>
    </div>

    <ErrorAlert Message="@Error" />
    <ErrorAlert Message="@RefreshError" />
    <ErrorAlert Message="@_metadataError" />

    <div class="workspace">
        <div class="workspace-main">
            <section class="panel">
                <h2 class="panel-title">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    分析进度
                    <span class="grow"></span>
                    <span class="chip chip-plain">耗时 @Ui.Elapsed(_task)</span>
                </h2>
                <div class="stagestrip" aria-hidden="true">
                    @for (var i = 0; i < StageNames.Length; i++)
                    {
                        <div class="stage @StageClass(i)">
                            <span class="stage-dot"></span>
                            <span>@StageNames[i]</span>
                        </div>
                    }
                </div>
                <div class="stagestrip-meta">
                    <span class="desc">@(_task.StageDescription ?? StageFallback)</span>
                    <span class="pct">@_task.ProgressPercent%</span>
                </div>
                <progress max="100" value="@_task.ProgressPercent" aria-label="分析进度"></progress>
                @if (_task.Status == AnalysisTaskStatus.Canceled)
                {
                    <p class="hint">任务已取消，处理中止。已生成的报告与分段内容保留在下方。</p>
                }
                <ErrorAlert Message="@_task.ErrorMessage" />
            </section>

            <section class="panel">
                <h2 class="panel-title">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>
                    解读报告
                </h2>
                @if (!string.IsNullOrEmpty(_task.ResultText))
                {
                    <div data-testid="final-report"><MarkdownContent Text="@_task.ResultText" /></div>
                }
                else if (_report.Length > 0)
                {
                    <p class="hint">当前生成片段，尚未形成完整报告。</p>
                    <div class="preview-box" aria-live="polite"><pre>@_report</pre></div>
                }
                else
                {
                    <p class="dim">@(Ui.IsActive(_task.Status) ? "分析完成后显示最终报告，生成时实时展示。" : "此任务未生成报告。")</p>
                }
            </section>

            <section class="panel">
                <h2 class="panel-title">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18M12 3v18"/></svg>
                    分段理解 <span class="chip chip-plain">@((_task.Segments?.Count ?? 0) + _live.Count) 段</span>
                </h2>
                @if ((_task.Segments?.Count ?? 0) == 0 && _live.Count == 0)
                {
                    <p class="dim">暂无分段理解内容。</p>
                }
                else
                {
                    <div class="seg-timeline">
                        @foreach (var segment in _task.Segments ?? [])
                        {
                            <details class="preview-box" open>
                                <summary>第 @(segment.Index + 1) 段 · @segment.StartSeconds.ToString("F1")–@segment.EndSeconds.ToString("F1") 秒</summary>
                                <pre>@segment.Text</pre>
                            </details>
                        }
                        @foreach (var entry in _live.Where(p => !(_task.Segments?.Any(s => s.Index == p.Key) ?? false)))
                        {
                            <div class="preview-box" aria-live="polite">
                                <span class="seg-live">第 @(entry.Key + 1) 段 · @(Ui.IsActive(_task.Status) ? "生成中…" : "未完成片段")</span>
                                <pre>@entry.Value</pre>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="panel">
                <h2 class="panel-title">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
                    分步日志
                </h2>
                @if (_task.Logs is { Count: > 0 })
                {
                    <ol class="task-logs" data-testid="task-logs">
                        @foreach (var entry in _task.Logs)
                        {
                            <li><time class="mono small">@entry.AtUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                                <span>@entry.Description · @entry.ProgressPercent%</span></li>
                        }
                    </ol>
                }
                else
                {
                    <p class="hint">@(_task.Status == AnalysisTaskStatus.Queued ? "排队等待分析" : "此历史任务没有保存分步日志。")</p>
                }
            </section>

            <section class="panel">
                <h2 class="panel-title">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
                    任务信息
                </h2>
                <div class="kv-grid">
                    <div><div class="kv-key">状态</div><div class="kv-val"><span class="@Ui.StatusClass(_task.Status)"><span class="dot"></span>@Ui.StatusName(_task.Status)</span></div></div>
                    <div><div class="kv-key">理解模式</div><div class="kv-val">@Ui.ModeName(_task.Mode)</div></div>
                    <div><div class="kv-key">分析模型</div><div class="kv-val">@(_task.ModelConfigId is null ? "未指定" : !_modelsLoaded ? "暂不可用" : ModelName ?? "模型已删除")</div></div>
                    <div><div class="kv-key">提示词模板</div><div class="kv-val">@(_task.PromptTemplateId is null ? "未使用" : !_promptsLoaded ? "暂不可用" : PromptName ?? "模板已删除")</div></div>
                    <div><div class="kv-key">创建时间</div><div class="kv-val mono">@Ui.Time(_task.CreatedAtUtc)</div></div>
                    <div><div class="kv-key">任务 ID</div><div class="kv-val mono small">@_task.Id</div></div>
                </div>
            </section>

            @if (_task.PromptContentSnapshot is { } snapshot)
            {
                <section class="panel">
                    <h2 class="panel-title">
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        提示词快照 <span class="chip chip-plain">创建时固化</span>
                    </h2>
                    <div class="preview-box"><pre>@snapshot</pre></div>
                </section>
            }
        </div>

        <div class="chat-rail">
            <ConversationPanel TaskId="Id" Enabled="@(_task.Status == AnalysisTaskStatus.Completed && !string.IsNullOrWhiteSpace(_task.ResultText))" />
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private static readonly string[] StageNames = ["排队", "预处理", "理解", "组合", "完成"];

    private TaskDto? _task;
    private string _report = "";
    private readonly Dictionary<int, string> _live = [];
    private bool _disposed;
    private bool _modelsLoaded, _promptsLoaded;
    private string? _metadataError;
    private List<ModelDto> _models = [];
    private List<PromptDto> _prompts = [];

    private string? ModelName => _models.FirstOrDefault(m => m.Id == _task?.ModelConfigId)?.ModelId;
    private string? PromptName => _prompts.FirstOrDefault(p => p.Id == _task?.PromptTemplateId)?.Name;

    /// <summary>完成前的阶段序号；失败/取消等终止态没有“当前阶段”。</summary>
    private static int StageOrder(AnalysisTaskStatus status) => status switch
    {
        AnalysisTaskStatus.Queued => 0,
        AnalysisTaskStatus.Preprocessing => 1,
        AnalysisTaskStatus.Understanding => 2,
        AnalysisTaskStatus.Combining => 3,
        _ => -1
    };

    private string StageClass(int index)
    {
        if (_task is null) return "";
        if (_task.Status == AnalysisTaskStatus.Completed) return "is-done";
        var order = StageOrder(_task.Status);
        if (index < order) return "is-done";
        if (index == order) return "is-now";
        return "";
    }

    private string StageFallback => _task is null ? "暂无阶段信息" : _task.Status switch
    {
        AnalysisTaskStatus.Queued => "排队等待处理",
        AnalysisTaskStatus.Failed => "处理失败",
        AnalysisTaskStatus.Canceled => "已取消",
        _ => "暂无阶段信息"
    };

    protected override Task OnInitializedAsync() => Refresh(RefreshTask);
    private void ReceiveText(AnalysisText update)
    {
        if (_disposed || update.TaskId != Id) return;
        if (update.Stage == "understanding") _live[update.SegmentIndex] =
            (_live.GetValueOrDefault(update.SegmentIndex) ?? "") + update.Text;
        if (update.Stage == "report") _report += update.Text;
    }

    private async Task RefreshTask()
    {
        _task = await Api.Get<TaskDto>($"api/tasks/{Id}");
        if (_disposed) return;
        try
        {
            if (!_modelsLoaded) { _models = await Api.Get<List<ModelDto>>("api/models"); _modelsLoaded = true; }
            if (!_promptsLoaded) { _prompts = await Api.Get<List<PromptDto>>("api/prompts"); _promptsLoaded = true; }
            _metadataError = null;
        }
        catch (Exception ex) when (ex is TaskCanceledException or HttpRequestException or InvalidOperationException)
        { _metadataError = "模型或模板信息暂时加载失败，正在自动重试。"; }
    }

    public void Dispose() => _disposed = true;

    private Task Cancel() => Run(async () =>
    {
        if (_disposed) return;
        await Api.Send(HttpMethod.Post, $"api/tasks/{Id}/cancel", new { });
        await RefreshTask();
    });

    private Task Delete() => Run(async () =>
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"删除「{_task!.OriginalFileName}」及视频、帧、音频、字幕和对话记录？")) return;
        if (_disposed) return;
        await Api.Delete($"api/tasks/{Id}");
        if (!_disposed) Nav.NavigateTo("tasks");
    });
}
