@using VideoNote.Shared.Contracts

<EditForm Model="Value" OnValidSubmit="Save" FormName="prompt">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <fieldset disabled="@Busy" style="border:none;padding:0;margin:0;">
        <div class="field">
            <label for="prompt-name">模板名称</label>
            <InputText id="prompt-name" class="form-control" @bind-Value="Value.Name" placeholder="例如 播客重点整理" />
        </div>
        <div class="field">
            <label for="prompt-content">模板内容</label>
            <InputTextArea id="prompt-content" rows="9" class="form-control" @bind-Value="Value.Content" placeholder="描述希望 AI 关注的重点与输出结构…" />
        </div>
        <div class="head-actions">
            <button type="submit" class="btn btn-primary">保存模板</button>
            <button type="button" class="btn btn-ghost" @onclick="Cancel">取消</button>
        </div>
    </fieldset>
</EditForm>
@code {
    [Parameter, EditorRequired] public PromptInput Value { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
}
